<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/comic_sync_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/standard_padding"
        android:paddingVertical="@dimen/standard_half_padding"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/comic_sync_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="Syncing comic library, 3 folders checked" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/comic_sync_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/standard_quarter_margin"
            android:indeterminate="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/comic_shelf_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/standard_double_padding"
        android:text="@string/comic_library_empty"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/comic_shelf_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/comic_shelf_padding" />
</LinearLayout>
